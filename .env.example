# ==============================================================================
# MONITORAMENTO DE PRAGAS & INTEGRAÇÃO QGIS - MODELO DE CONFIGURAÇÃO (.env.example)
# Copie este arquivo para .env e ajuste os valores conforme o seu ambiente:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APLICAÇÃO E AMBIENTE
# ------------------------------------------------------------------------------
# Ambiente de execução: development | staging | production
APP_ENV=development

# Nome da aplicação exibido na interface
APP_NAME="Monitoramento de Pragas & QGIS"

# Habilitar logs detalhados de debug no console
ENABLE_LOGGING=true

# ------------------------------------------------------------------------------
# 2. API BACKEND & SINCRONIZAÇÃO
# ------------------------------------------------------------------------------
# URL base padrão da API para Web, iOS, macOS, Linux, Windows e Produção
# Produção/Remoto: https://bicudos.fdevs.io/api/v1
# Local: http://localhost:3000/api/v1
API_BASE_URL=https://bicudos.fdevs.io/api/v1

# URL base para Android
# Produção/Remoto: https://bicudos.fdevs.io/api/v1
# Local no Emulador Android: http://10.0.2.2:3000/api/v1
# Em aparelho físico local Wi-Fi: ex. http://192.168.1.50:3000/api/v1
API_BASE_URL_ANDROID=https://bicudos.fdevs.io/api/v1

# Tempo limite para requisições HTTP à API (em segundos)
API_TIMEOUT_SECONDS=15

# Quantidade máxima de registros sincronizados por lote (batch size)
API_SYNC_BATCH_SIZE=200

# ------------------------------------------------------------------------------
# 3. CARTOGRAFIA, MAPA & INTEGRAÇÃO QGIS
# ------------------------------------------------------------------------------
# Template de URL do servidor de tiles do mapa (OpenStreetMap, Mapbox, Satélite, etc.)
# Exemplos:
# - OpenStreetMap: https://tile.openstreetmap.org/{z}/{x}/{y}.png
# - OpenTopoMap: https://tile.opentopomap.org/{z}/{x}/{y}.png
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Identificador de pacote para o cabeçalho User-Agent exigido pelos provedores de tiles
MAP_USER_AGENT=com.agro.monitoramento

# Coordenadas padrão de fallback (quando o GPS estiver indisponível ou para centro da fazenda)
# Padrão: Brasília (-15.7942, -47.8822) ou substitua pelas coordenadas do talhão principal
MAP_DEFAULT_LAT=-15.7942
MAP_DEFAULT_LNG=-47.8822

# Nível de zoom inicial do mapa (ex: 15.0 para visão de talhão)
MAP_DEFAULT_ZOOM=15.0

# Nível máximo de zoom permitido no mapa
MAP_MAX_ZOOM=19.0

# ------------------------------------------------------------------------------
# 4. GPS & GEOLOCALIZAÇÃO
# ------------------------------------------------------------------------------
# Tempo limite para aquisição de sinal GPS de alta precisão (em segundos)
GPS_TIMEOUT_SECONDS=12

# Precisão desejada do GPS: low | medium | high | best
GPS_DESIRED_ACCURACY=high

# ------------------------------------------------------------------------------
# 5. BANCO DE DADOS LOCAL (SQLITE OFFLINE-FIRST)
# ------------------------------------------------------------------------------
# Nome do arquivo de banco de dados SQLite local no dispositivo
DATABASE_NAME=monitoramento_pragas.db

# Habilitar sincronização automática ao iniciar ou em segundo plano
SYNC_AUTO_ENABLED=false
